<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sast.crs.mapper.TeamMapper">
    <insert id="upsertTeam" parameterType="com.sast.crs.entity.Team">
        INSERT INTO team (com_id, name, captain, member, teacher)
        VALUES (#{comId}, #{name}, #{captain}, #{member}, #{teacher})
        ON DUPLICATE KEY UPDATE
            name = VALUES(name),
            member = VALUES(member),
            teacher = VALUES(teacher)
    </insert>

    <resultMap id="TeamInfoWithComMap" type="com.sast.crs.model.TeamInfoWithCom">
        <result column="com_type" property="comType"/>
        <result column="team_name" property="teamName"/>
        <result column="member" property="member"/>
        <result column="teacher" property="teacher"/>
    </resultMap>

    <!--
      只查「我是队长」的那一条队伍记录：team 表有 UNIQUE (com_id, captain)，所以最多一条；
      member / teacher 是两个 text 列（JSON 文本），这里原样取出，不在 SQL 里展开。

      注意：不要在这里用 JSON_TABLE / JSON_ARRAYAGG。JSON_TABLE 需要 MySQL 8.0.4+，
      而生产库是 MySQL 5.7，用了会让整个接口 500（SQLSyntaxErrorException: ... near 'JSON_TABLE(...)'）。
      队员 / 指导老师的展开放在 UserServiceImpl#getTeamInfo 里用 fastjson 完成。
    -->
    <select id="selectTeamInfoWithCom" resultMap="TeamInfoWithComMap">
        SELECT
            c.type AS com_type,
            t.name AS team_name,
            t.member AS member,
            t.teacher AS teacher
        FROM team t
                 JOIN competition c ON c.id = t.com_id
        WHERE t.com_id = #{comId}
          AND t.captain = #{captainCode}
    </select>
</mapper>
