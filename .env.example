# docker compose 配置模板
# 使用方式：复制为 .env（已加入 .gitignore，不会提交），按需修改后 docker compose up -d

# JWT 签名密钥：本地开发可用默认值；生产必须换成随机长串（如 openssl rand -hex 32）
JWT_SECRET=dev-only-change-me

# MySQL root 密码：注意仅在「首次创建 mysql 数据卷」时生效
# 已有数据卷要改密码：docker compose down -v 重建，或 docker compose exec mysql mysql -uroot -p 后 ALTER USER
MYSQL_ROOT_PASSWORD=root

# Redis（使用外部共享 Redis 时填写；自带 compose 的 Redis 无密码可留空）
REDIS_PASSWORD=
REDIS_DATABASE=0

# 腾讯云 COS（使用文件上传/下载功能时必填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=
COS_REGION=ap-shanghai
COS_PUBLIC_FOLDER=crs-public
COS_PRIVATE_FOLDER=crs-private
